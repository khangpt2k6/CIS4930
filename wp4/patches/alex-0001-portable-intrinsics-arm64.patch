From e7831958f8fd50e2717f1a7b822a4e0ca480993f Mon Sep 17 00:00:00 2001
From: sevbad <sbadriddinova@usf.edu>
Date: Wed, 25 Nov 2026 15:38:39 +0000
Subject: [PATCH] Portable bit intrinsics for non-x86 (ARM64)

---
 src/core/alex_base.h | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/src/core/alex_base.h b/src/core/alex_base.h
index 82ae846..653ea00 100644
--- a/src/core/alex_base.h
+++ b/src/core/alex_base.h
@@ -24,8 +24,20 @@
 #include <vector>
 #ifdef _MSC_VER
 #include <intrin.h>
-#else
+#elif defined(__x86_64__) || defined(__i386__)
 #include <x86intrin.h>
+#else
+// Portable fallbacks for non-x86 targets (e.g. ARM64 / Apple Silicon).
+// Same semantics as the x86 intrinsics, including lzcnt(0) == tzcnt(0) == 64.
+static inline long long _mm_popcnt_u64(unsigned long long x) {
+  return __builtin_popcountll(x);
+}
+static inline unsigned long long _lzcnt_u64(unsigned long long x) {
+  return x ? __builtin_clzll(x) : 64;
+}
+static inline unsigned long long _tzcnt_u64(unsigned long long x) {
+  return x ? __builtin_ctzll(x) : 64;
+}
 #endif
 #include <bitset>
 #include <cassert>
@@ -369,6 +381,7 @@ inline int log_2_round_down(int x) {
   return res;
 }
 
+#if defined(_WIN32) || defined(__x86_64__) || defined(__i386__)
 // https://stackoverflow.com/questions/1666093/cpuid-implementations-in-c
 class CPUID {
   uint32_t regs[4];
@@ -394,4 +407,8 @@ class CPUID {
 inline bool cpu_supports_bmi() {
   return static_cast<bool>(CPUID(7, 0).EBX() & (1 << 3));
 }
+#else
+// Non-x86: _lzcnt_u64/_tzcnt_u64 above are portable builtins with BMI semantics.
+inline bool cpu_supports_bmi() { return true; }
+#endif
 }
\ No newline at end of file
