From: sevbad <sbadriddinova@usf.edu>
Date: Thu, 12 Nov 2026 10:07:35 -0500
Subject: [PATCH 1/2] Add Apple Silicon support and benchmark results

---
 CMakeLists.txt                                | 24 ++++++-
 benchmark.cc                                  | 68 +++++++++++++++++++
 benchmark.h                                   | 19 ++++--
 competitors/hash.h                            |  5 +-
 competitors/rs.h                              |  9 ++-
 results/lognormal_1M_uint64_results_table.csv | 25 +++++++
 results/pgm_lognormal_1M_pareto.csv           | 25 +++++++
 results/rs_lognormal_1M_pareto.csv            | 15 ++++
 8 files changed, 177 insertions(+), 13 deletions(-)
 create mode 100644 results/lognormal_1M_uint64_results_table.csv
 create mode 100644 results/pgm_lognormal_1M_pareto.csv
 create mode 100644 results/rs_lognormal_1M_pareto.csv

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 00436f5..b20785f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -29,6 +29,19 @@ set(SOURCE_FILES util.h)
 file(GLOB_RECURSE RMI_SOURCES "competitors/rmi/*.cpp")
 file(GLOB_RECURSE BENCH_SOURCES "benchmarks/*.cc")
 
+# SOSD_ARM64_PORTABLE_BEGIN
+# On Apple Silicon, start with portable algorithms and exclude Intel intrinsics.
+# Intel/AMD retain the original full competitor set.
+if(APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
+    set(SOSD_ARM64_PORTABLE TRUE)
+    set(BENCH_SOURCES
+        "${CMAKE_SOURCE_DIR}/benchmarks/benchmark_btree.cc"
+        "${CMAKE_SOURCE_DIR}/benchmarks/benchmark_pgm.cc"
+        "${CMAKE_SOURCE_DIR}/benchmarks/benchmark_rs.cc"
+    )
+endif()
+# SOSD_ARM64_PORTABLE_END
+
 if (CMAKE_CXX_COMPILER_VERSION VERSION_LESS 10.0)
     # FIXME cannot link with g++-9
     add_definitions(-DDISABLE_FST=1)
@@ -68,7 +81,11 @@ target_include_directories(benchmark
         PRIVATE "competitors/stx-btree-0.9/include"
         PRIVATE "competitors/ts/include"
         PRIVATE "fast64")
-add_dependencies(benchmark libfast64)
+if(SOSD_ARM64_PORTABLE)
+    target_compile_definitions(benchmark PRIVATE SOSD_ARM64_PORTABLE=1)
+else()
+    add_dependencies(benchmark libfast64)
+endif()
 
 if (${LINUX})
     target_include_directories(benchmark PRIVATE "wormhole")
@@ -76,8 +93,11 @@ if (${LINUX})
     add_dependencies(benchmark libwh)
 endif ()
 
+if(NOT SOSD_ARM64_PORTABLE)
+    target_link_libraries(benchmark PRIVATE ${CMAKE_SOURCE_DIR}/fast64/target/release/libfast64.a)
+endif()
 target_link_libraries(benchmark
-        PRIVATE ${CMAKE_SOURCE_DIR}/fast64/target/release/libfast64.a
+        
         PRIVATE tsl::robin_map
         PRIVATE Threads::Threads dtl
         PRIVATE dl)
