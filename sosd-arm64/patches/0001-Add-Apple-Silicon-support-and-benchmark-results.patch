                  {20, 9},   {20, 5},   {22, 3},  {26, 2},  {26, 1}};
     } else {
-      // No config.
-      return false;
-    }
+    // Memory-efficient configurations for custom datasets.
+    configs = {
+        {8, 32}, {9, 32}, {10, 32}, {11, 32}, {12, 32},
+        {13, 32}, {14, 32}, {15, 32}, {16, 32}, {17, 32}
+    };
+  }
 
     const Config config = configs[size_scale - 1];
     num_radix_bits_ = config.first;
